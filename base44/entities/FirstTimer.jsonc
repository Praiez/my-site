{
  "name": "FirstTimer",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "occupation": {
      "type": "string"
    },
    "marital_status": {
      "type": "string",
      "enum": [
        "Single",
        "Married",
        "Widowed",
        "Divorced",
        "Separated",
        "Prefer not to say"
      ]
    },
    "birth_month": {
      "type": "integer"
    },
    "birth_day": {
      "type": "integer"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "full_name",
    "phone"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}